        function renderWheel() {
            const svg = document.getElementById('wheel-svg');
            svg.innerHTML = ''; // Clear existing SVG contents

            const cx = 200;
            const cy = 200;
            const radius = 180;
            const innerRadius = 70;

            // Draw outer circle track
            const outerCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            outerCircle.setAttribute('cx', cx);
            outerCircle.setAttribute('cy', cy);
            outerCircle.setAttribute('r', radius + 4);
            outerCircle.setAttribute('fill', 'none');
            outerCircle.setAttribute('stroke', '#2c394e');
            outerCircle.setAttribute('stroke-width', '2');
            svg.appendChild(outerCircle);

            // Render each Sabbat arc sector
            sabbats.forEach(sabbat => {
                const isActive = sabbat.id === selectedSabbatId;
                const matchesFilter = (currentFilter === 'all') || (sabbat.category === currentFilter);
                const matchesSearch = searchQuery === '' || sabbat.name.toLowerCase().includes(searchQuery) || sabbat.season.toLowerCase().includes(searchQuery);

                const startAngle = sabbat.angles.start;
                const endAngle = sabbat.angles.end;

                const pathData = describeArc(cx, cy, innerRadius, radius, startAngle, endAngle);

                const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                path.setAttribute('d', pathData);
                path.setAttribute('fill', sabbat.color);
                path.setAttribute('fill-opacity', isActive ? '0.85' : '0.4');
                path.setAttribute('stroke', isActive ? '#f6d365' : '#1e2838');
                path.setAttribute('stroke-width', isActive ? '3' : '1.5');
                
                let classes = 'wheel-sector';
                if (isActive) classes += ' active';
                if (!matchesFilter || !matchesSearch) classes += ' dimmed';
                path.setAttribute('class', classes);

                path.onclick = () => selectSabbat(sabbat.id);

                // Tooltip title
                const title = document.createElementNS('http://www.w3.org/2000/svg', 'title');
                title.textContent = `${sabbat.name} (${sabbat.season})`;
                path.appendChild(title);

                svg.appendChild(path);

                // Add text label along radius
                const midAngle = (startAngle + (endAngle < startAngle ? endAngle + 360 : endAngle)) / 2;
                const labelRadius = (innerRadius + radius) / 2;
                const labelPos = polarToCartesian(cx, cy, labelRadius, midAngle);

                const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                text.setAttribute('x', labelPos.x);
                text.setAttribute('y', labelPos.y);
                text.setAttribute('text-anchor', 'middle');
                text.setAttribute('dominant-baseline', 'central');
                text.setAttribute('fill', isActive ? '#ffffff' : '#e2e8f0');
                text.setAttribute('font-size', '11');
                text.setAttribute('font-weight', isActive ? 'bold' : '600');
                text.setAttribute('class', 'pointer-events-none heading-serif');
                text.textContent = `${sabbat.symbol} ${sabbat.name}`;
                
                svg.appendChild(text);
            });
        }

        // SVG Helper to calculate Cartesian points from polar angles
        function polarToCartesian(centerX, centerY, radius, angleInDegrees) {
            const angleInRadians = (angleInDegrees - 90) * Math.PI / 180.0;
            return {
                x: centerX + (radius * Math.cos(angleInRadians)),
                y: centerY + (radius * Math.sin(angleInRadians))
            };
        }

        // SVG Arc Generator helper
        function describeArc(x, y, innerR, outerR, startAngle, endAngle) {
            let actualEndAngle = endAngle;
            if (endAngle < startAngle) {
                actualEndAngle += 360;
            }

            const startOuter = polarToCartesian(x, y, outerR, startAngle);
            const endOuter = polarToCartesian(x, y, outerR, actualEndAngle);
            const startInner = polarToCartesian(x, y, innerR, actualEndAngle);
            const endInner = polarToCartesian(x, y, innerR, startAngle);

            const largeArcFlag = actualEndAngle - startAngle <= 180 ? "0" : "1";

            return [
                "M", startOuter.x, startOuter.y,
                "A", outerR, outerR, 0, largeArcFlag, 1, endOuter.x, endOuter.y,
                "L", startInner.x, startInner.y,
                "A", innerR, innerR, 0, largeArcFlag, 0, endInner.x, endInner.y,
                "Z"
            ].join(" ");
        }

        function updateDetailCard() {
            const sabbat = sabbats.find(s => s.id === selectedSabbatId);
            if (!sabbat) return;

            // Center Knob updates
            document.getElementById('center-symbol').textContent = sabbat.symbol;
            document.getElementById('center-title').textContent = sabbat.name;
            document.getElementById('center-date').textContent = currentHemisphere === 'northern' ? sabbat.dateNorth : sabbat.dateSouth;

            // Header Elements
            document.getElementById('card-badge').textContent = sabbat.categoryLabel;
            document.getElementById('card-badge').className = `px-2.5 py-0.5 rounded-full text-[11px] font-semibold ${
                sabbat.category === 'solar' ? 'bg-amber-400/10 text-amber-300 border border-amber-400/20' : 'bg-emerald-400/10 text-emerald-300 border border-emerald-400/20'
            }`;
            document.getElementById('card-season').textContent = sabbat.season;
            document.getElementById('card-name').innerHTML = `${sabbat.symbol} ${sabbat.name}`;
            document.getElementById('card-phonetic').textContent = `/${sabbat.phonetic}/`;
            document.getElementById('card-date').textContent = currentHemisphere === 'northern' ? sabbat.dateNorth : sabbat.dateSouth;

            // Meaning
            document.getElementById('card-meaning').textContent = sabbat.meaning;

            // Popular List
            const popularUl = document.getElementById('card-popular');
            popularUl.innerHTML = sabbat.popular.map(item => `<li>${item}</li>`).join('');

            // Easy List
            const easyUl = document.getElementById('card-easy');
            easyUl.innerHTML = sabbat.easy.map(item => `<li>${item}</li>`).join('');

            // Color Tags
            const colorsDiv = document.getElementById('card-colors');
            colorsDiv.innerHTML = sabbat.colors.map(c => `<span class="px-2 py-0.5 rounded-md bg-mystic-700 text-slate-200 text-[10px] font-medium border border-slate-600/40">${c}</span>`).join('');

            // Herbs & Symbols
            document.getElementById('card-herbs').textContent = sabbat.herbs;
            document.getElementById('card-symbols').textContent = sabbat.symbols;

            renderWheel();
            updateQuickPillStyles();
        }

        // Render bottom Quick Pills
        function renderQuickPills() {
            const pillsContainer = document.getElementById('quick-pills');
            pillsContainer.innerHTML = sabbats.map(s => `
                <button onclick="selectSabbat('${s.id}')" id="pill-${s.id}" class="px-2.5 py-1 rounded-xl text-xs font-medium transition-all bg-mystic-800 text-slate-400 hover:text-white hover:bg-mystic-700 border border-slate-800">
                    ${s.symbol} ${s.name}
                </button>
            `).join('');
        }

        function updateQuickPillStyles() {
            sabbats.forEach(s => {
                const pill = document.getElementById(`pill-${s.id}`);
                if (pill) {
                    if (s.id === selectedSabbatId) {
                        pill.className = "px-2.5 py-1 rounded-xl text-xs font-semibold bg-gold-500/20 text-gold-400 border border-gold-500/40 shadow-sm";
                    } else {
                        pill.className = "px-2.5 py-1 rounded-xl text-xs font-medium transition-all bg-mystic-800 text-slate-400 hover:text-white hover:bg-mystic-700 border border-slate-800";
                    }
                }
            });
        }

        // User Selection handlers
        function selectSabbat(id) {
            selectedSabbatId = id;
            updateDetailCard();
        }

        function setCategoryFilter(cat) {
            currentFilter = cat;
            
            // Update button styles
            const btnAll = document.getElementById('btn-filter-all');
            const btnSolar = document.getElementById('btn-filter-solar');
            const btnCross = document.getElementById('btn-filter-cross-quarter');

            const inactiveStyle = "filter-btn px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-medium transition-all bg-mystic-700 text-slate-300 hover:text-white hover:bg-mystic-600";
            const activeStyle = "filter-btn px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-gold-500 text-mystic-900 shadow-md";

            btnAll.className = cat === 'all' ? activeStyle : inactiveStyle;
            btnSolar.className = cat === 'solar' ? activeStyle : inactiveStyle;
            btnCross.className = cat === 'cross-quarter' ? activeStyle : inactiveStyle;

            renderWheel();
        }

        function setHemisphere(hemi) {
            currentHemisphere = hemi;
            const btnNorth = document.getElementById('btn-hemi-north');
            const btnSouth = document.getElementById('btn-hemi-south');

            if (hemi === 'northern') {
                btnNorth.className = "px-2.5 py-1 rounded-lg text-xs font-medium bg-gold-500/20 text-gold-400 border border-gold-500/30";
                btnSouth.className = "px-2.5 py-1 rounded-lg text-xs font-medium text-slate-400 hover:text-slate-200";
            } else {
                btnSouth.className = "px-2.5 py-1 rounded-lg text-xs font-medium bg-gold-500/20 text-gold-400 border border-gold-500/30";
                btnNorth.className = "px-2.5 py-1 rounded-lg text-xs font-medium text-slate-400 hover:text-slate-200";
            }

            updateDetailCard();
        }

        function handleSearch(val) {
            searchQuery = val.toLowerCase().trim();
            renderWheel();
        }

        function speakPronunciation() {
            const sabbat = sabbats.find(s => s.id === selectedSabbatId);
            if (!sabbat) return;

            if ('speechSynthesis' in window) {
                // Cancel any ongoing speech
                window.speechSynthesis.cancel();

                const utterance = new SpeechSynthesisUtterance(sabbat.name);
                utterance.rate = 0.85; // Slightly slower for clarity
                utterance.pitch = 1.0;
                
                // Prefer English voice if available
                const voices = window.speechSynthesis.getVoices();
                const englishVoice = voices.find(v => v.lang.includes('en'));
                if (englishVoice) utterance.voice = englishVoice;

                window.speechSynthesis.speak(utterance);
            } else {
                alert(`Pronunciation guide: /${sabbat.phonetic}/`);
            }
        }
    </script>
</body>
